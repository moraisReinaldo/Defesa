# Como o Mac Mini tem pouca memória na VM (Colima com 2GB),
# vamos compilar o Flutter nativamente no Mac e usar o Docker
# apenas para hospedar o Nginx.

FROM nginx:alpine

# Remove o HTML padrão do nginx
RUN rm -rf /usr/share/nginx/html/*

# Copia os arquivos gerados nativamente pelo Flutter
COPY build/web /usr/share/nginx/html

# Expõe a porta 80 do nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
