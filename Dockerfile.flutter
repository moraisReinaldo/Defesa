# ==============================================================
# Dockerfile.flutter — Frontend Flutter Web (Defesa em Foco)
# ==============================================================
# Build em duas etapas:
#   Stage 1 (build-web): Compila Flutter para Web
#   Stage 2 (runtime):   Nginx Alpine serve os arquivos estáticos
#
# Build:
#   docker build -t defesacivil-frontend:latest .
# ==============================================================

# ── Stage 1: Compilação Flutter ───────────────────────────────
FROM ghcr.io/cirruslabs/flutter:3.22.3 AS build-web

WORKDIR /app

# Copiar manifesto de dependências primeiro (cache de layers)
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copiar o restante do código-fonte
COPY lib/ ./lib/
COPY web/ ./web/
COPY assets/ ./assets/

# Compilar para Web (release otimizado)
RUN flutter build web --release \
    --dart-define=FLUTTER_WEB_USE_SKIA=true \
    --web-renderer canvaskit

# ── Stage 2: Runtime Nginx ────────────────────────────────────
FROM nginx:1.25-alpine AS runtime

# Labels OCI para rastreabilidade
LABEL org.opencontainers.image.title="Defesa Civil Frontend" \
      org.opencontainers.image.description="Flutter Web app do sistema Defesa em Foco" \
      org.opencontainers.image.vendor="Defesa Civil" \
      org.opencontainers.image.source="https://github.com/moraisReinaldo/Defesa"

# Remover HTML padrão e copiar build do Flutter
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build-web /app/build/web /usr/share/nginx/html

# Configuração do Nginx para SPA (Single Page Application)
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    server_tokens off;\n\
    gzip on;\n\
    gzip_types text/plain application/javascript text/css application/json;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|wasm|woff2)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Porta exposta
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

