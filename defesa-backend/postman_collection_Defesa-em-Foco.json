    {
      "name": "4.1 Autenticação",
      "item": [
        {
          "name": "1. Cadastro de Usuário (Cidadão)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/cadastro", "host": ["{{base_url}}"], "path": ["api", "auth", "cadastro"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@teste.com\",\n  \"telefone\": \"(11) 99999-9999\",\n  \"senha\": \"Senha123!\",\n  \"cidade\": \"SAO PAULO\",\n  \"role\": \"CIDADAO\",\n  \"concordaLGPD\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "2. Login (salva token automaticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('usuario_id', json.usuario.id);",
                  "    console.log('Token salvo automaticamente!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/usuarios/login", "host": ["{{base_url}}"], "path": ["api", "usuarios", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@teste.com\",\n  \"senha\": \"Senha123!\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "3. Login Admin (salva token admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
