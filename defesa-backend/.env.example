# ==============================================================
# .env.example — Template de variáveis de ambiente
# ==============================================================
# Copie para '.env' e preencha com os valores reais:
#   cp .env.example .env
#   nano .env
#
# O arquivo '.env' é ignorado pelo Git (contém senhas).
# O docker-compose.yml lê automaticamente o '.env'.
# ==============================================================

# ===== BANCO DE DADOS (PostgreSQL) =====
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/defesacivil_db
DATABASE_USERNAME=defesacivil
DATABASE_PASSWORD=SUA_SENHA_DB

# ===== MinIO (Armazenamento de Fotos) =====
MINIO_ENDPOINT=https://fotos.rhprogramer.com.br
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=SUA_SENHA_MINIO
MINIO_BUCKET=defesa-civil

# ===== Autenticação / JWT =====
# Admin password: pode ser texto plano (dev) ou hash BCrypt (produção)
APP_ADMIN_PASSWORD=SUA_SENHA_ADMIN
# JWT Secret: string aleatória com 32+ caracteres
APP_JWT_SECRET=SuaChaveSuperSecretaComMaisDe32Caracteres

# ===== Super Admin (Seed inicial) =====
APP_SUPER_ADMIN_EMAIL=seu_email@gmail.com
APP_SUPER_ADMIN_NOME=Seu Nome
APP_SUPER_ADMIN_SENHA=SUA_SENHA_SUPER_ADMIN

# ===== E-mail (SMTP - Gmail) =====
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=SUA_APP_PASSWORD_GMAIL
APP_ADMIN_NOTIFICATION_EMAIL=seu_email@gmail.com

# ===== Stripe (Pagamentos) =====
STRIPE_SECRET_KEY=sk_live_ou_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== OneSignal (Push Notifications) =====
ONESIGNAL_APP_ID=seu-app-id-onesignal
ONESIGNAL_REST_KEY=os_v2_app_...

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://defesa.rhprogramer.com.br
